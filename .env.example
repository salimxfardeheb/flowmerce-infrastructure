# ═══════════════════════════════════════════════════════════════
#  Flowmerce — Variables d'environnement (modèle)
#
#  Copier ce fichier vers .env puis renseigner les valeurs :
#      cp .env.example .env
#
#  .env est ignoré par Git — n'y committez JAMAIS de secret réel.
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  PORTS EXPOSÉS SUR LA MACHINE HÔTE
# ───────────────────────────────────────────────────────────────
# Port du service web (Next.js). Publié sur toutes les interfaces.
WEB_PORT=3000

# Port du service ml (FastAPI). Publié sur 127.0.0.1 uniquement :
# `web` appelle l'API via le réseau Docker, pas via l'hôte.
ML_PORT=8000


# ───────────────────────────────────────────────────────────────
#  COMMUNICATION INTERNE web → ml
# ───────────────────────────────────────────────────────────────
# Nom de service Docker, jamais localhost : depuis le conteneur `web`,
# `localhost` désignerait le conteneur lui-même.
ML_API_URL=http://ml:8000

# Clé partagée envoyée par `web` dans l'en-tête X-Internal-Key et
# vérifiée par `ml`. Compose l'injecte des deux côtés (INTERNAL_API_KEY
# côté ml) : une seule valeur à maintenir. Minimum 8 caractères.
ML_INTERNAL_SECRET=


# ───────────────────────────────────────────────────────────────
#  SERVICE ml — ARTEFACTS MACHINE LEARNING
# ───────────────────────────────────────────────────────────────
# Repository Hugging Face contenant les artefacts (model_resolution,
# ohe_encoder, scaler, train_columns, training_params).
# REQUIS : config.py force USE_HF_MODELS = True.
HF_REPO_ID=

# Token Hugging Face. Laisser vide si le repository est public.
HF_TOKEN=

# Dataset d'entraînement sur le Hub — optionnel, utilisé par les
# scripts de pipeline, pas par l'API servie en conteneur.
HF_DATASET_REPO=
HF_DATASET_FILE=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — BASE DE DONNÉES POSTGRESQL EXTERNE
# ───────────────────────────────────────────────────────────────
# PostgreSQL est hors périmètre de ce docker-compose : pointer vers
# une instance managée (Supabase, Neon, …) accessible depuis le conteneur.
# Format attendu : postgresql://user:password@host:port/database
DATABASE_URL=
DIRECT_URL=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — AUTHENTIFICATION (NextAuth)
# ───────────────────────────────────────────────────────────────
# 32 caractères minimum. Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# Auth.js v5 rejette en production toute requête dont l'hôte n'est pas déclaré
# de confiance (erreur UntrustedHost). Il détecte Vercel automatiquement, mais
# pas un conteneur Docker : cette variable est donc nécessaire ici.
#
# À true, Auth.js fait confiance aux en-têtes Host / X-Forwarded-Host de la
# requête. C'est le réglage attendu en local et derrière un reverse proxy que
# vous maîtrisez.
AUTH_TRUST_HOST=true

# Origine canonique du site, utilisée par Auth.js pour construire ses
# redirections (retour après connexion, page d'erreur…).
# Laisser vide reprend NEXT_PUBLIC_BASE_URL, ce qui convient dans la plupart
# des cas. Ne pas la définir du tout ferait déduire l'origine du HOSTNAME du
# serveur Next standalone — 0.0.0.0 en conteneur — et produirait des
# redirections vers http://0.0.0.0:3000/… , injoignables depuis un navigateur.
AUTH_URL=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — SUPABASE
# ───────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — TÂCHES PLANIFIÉES
# ───────────────────────────────────────────────────────────────
# 32 caractères minimum. Générer avec : openssl rand -hex 32
CRON_SECRET=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — ENVOI D'E-MAILS
# ───────────────────────────────────────────────────────────────
GMAIL_USER=
# Mot de passe d'application Gmail — 16 caractères minimum.
GMAIL_APP_PASSWORD=


# ───────────────────────────────────────────────────────────────
#  SERVICE web — URL PUBLIQUE
# ───────────────────────────────────────────────────────────────
# Inlinée dans le bundle client AU MOMENT DU BUILD : après
# modification, reconstruire avec `docker compose build web`.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
